# Default: persistent local SQLite, no credentials required.
LOOPBOX_DB=data/loopbox.sqlite
# Quick demo identities are intentionally enabled only in demo mode.
DEMO_MODE=true
# Stripe TEST mode secret key (sk_test_...). Server-only. Leave empty to use simulated payments.
STRIPE_SECRET_KEY=
# Signing secret printed by `stripe listen` (whsec_...). Server-only.
STRIPE_WEBHOOK_SECRET=
# Public base URL used for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# In demo mode, pay with a simulated webhook instead of Stripe.
SIMULATE_PAYMENTS=true
# Adds the Admin identity to the demo switcher. Set false on any public deployment.
ADMIN_DEMO=true
